#ifndef FIX_MNC2
#define FIX_MNC2

PUSH
	ORG $00F464
		POIN MoveToChapter2Hook

	//Fixes the game considering some chapters postgame.
	ORG 0x897C4
	SHORT 0x200E 0x5620 //mov r0, #0x0E; ldsb r0, [r4, r0]

	//Fix MapLoadingProcess
	ORG 0xBD074
	BYTE 0xB6 0xE0
POP

ALIGN 4
MoveToChapter2Hook:
#incbin "MNC2Fix.dmp"

#else // FIX_MNC2

PUSH
    //Fix MNC2 Freezing glitch (breaks skirmishes!)
    ORG $BD070
    SHORT $E0B8
POP

#endif // FIX_MNC2
